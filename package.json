    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "stripe": "^22.1.1",
    "tesseract.js": "^7.0.0",
    "viem": "^2.49.3",
    "wagmi": "^3.6.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
